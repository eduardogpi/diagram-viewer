# Copie para .env e preencha os valores. Nunca commite o .env real.
DATABASE_URL="file:./dev.db"

# Chave mestra para criptografia AES-256-GCM das senhas e assinatura HMAC do cookie de sessão.
# Gere com: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Providers LLM (opcionais)
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
NVIDIA_API_KEY=""

# Memória CodeGraph (opcional)
CODEGRAPH_MCP_URL=""
CODEGRAPH_MCP_TOKEN=""

# TLS para bancos remotos (opcional, verificação de certificado ATIVA por padrão)
# MYSQL_SSL="true"
# MYSQL_SSL_MODE="require"
# MYSQL_CA_CERT="/caminho/rds-ca.pem"
# POSTGRES_SSL="true"
# POSTGRES_CA_CERT="/caminho/supabase-ca.pem"

# Anti-SSRF: bloqueia IPs privados/loopback/link-local no cadastro de conexão.
# Nunca habilite em produção.
# ALLOW_PRIVATE_DB_HOSTS="1"

# MCP HTTP (opcional)
# MCP_HTTP_TOKEN="um-segredo-longo"
# MCP_HTTP_HOST="127.0.0.1"
# MCP_HTTP_PORT="3847"
# URL que os clientes devem usar, exibida no card da página inicial (útil atrás de proxy/Docker).
# Omitida = http://MCP_HTTP_HOST:MCP_HTTP_PORT/mcp
# MCP_HTTP_PUBLIC_URL="https://mcp.exemplo.com/mcp"
